[sub_resource type="GDScript" id="GDScript_se02k"]
script/source = "extends PanelContainer

var id
var mainNode
var editNode
var moveView=false


func _ready() -> void:
	change()

func change():
	if moveView:
		$HFlowContainer/Button.visible=true
	else:
		$HFlowContainer/Button.visible=false
	
	$HFlowContainer/Label.text=mainNode.tagsData[id][\"name\"]
	$HFlowContainer/TextureRect.texture=load(mainNode.tagsData[id][\"iconPath\"])


func _on_button_pressed() -> void:
	editNode.childEvent(id)
	pass # Replace with function body.
"

