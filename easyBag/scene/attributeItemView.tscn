[gd_scene load_steps=3 format=3 uid="uid://cnrm6p6xln7ba"]

[ext_resource type="Texture2D" uid="uid://tp2t77ckd7nq" path="res://icon.svg" id="1_uxysd"]

[sub_resource type="GDScript" id="GDScript_uxysd"]
script/source = "extends PanelContainer

var id
var mainNode
var editNode
var moveView=false
var showVal=true
var editVal=false
var fromItem=null

func _ready() -> void:
	change()


func valChangUi():
	var kind
	var val:Variant
	kind=mainNode.attributesData[id][\"kind\"]
	if not fromItem==null:
		val=mainNode.itemData[fromItem][\"attributesVal\"][id][\"val\"]
	else:
		val=mainNode.attributesData[id][\"val\"]
	if kind==\"int\":
		$VBoxContainer/val/intVal.visible=true
		$VBoxContainer/val/intVal.value=int(val)
	else:
		$VBoxContainer/val/intVal.visible=false

func change():
	if moveView:
		$VBoxContainer/move.visible=true
	else:
		$VBoxContainer/move.visible=false
	
	if editVal:
		$VBoxContainer/val/intVal.editable=true
		$VBoxContainer/val/strVal.editable=true
		$VBoxContainer/val/boolVal.disabled=false
		$VBoxContainer/val/floatVal.editable=true
		$VBoxContainer/val/extendsVal.disabled=false
	else:
		$VBoxContainer/val/intVal.editable=false
		$VBoxContainer/val/strVal.editable=false
		$VBoxContainer/val/boolVal.disabled=true
		$VBoxContainer/val/floatVal.editable=false
		$VBoxContainer/val/extendsVal.disabled=true
	
	if showVal:
		$VBoxContainer/val.visible=true
	else:
		$VBoxContainer/val.visible=false
	$VBoxContainer/info/Label.text=mainNode.attributesData[id][\"name\"]
	$VBoxContainer/info/TextureRect.texture=load(mainNode.attributesData[id][\"iconPath\"])
	
	valChangUi()

func _on_button_pressed() -> void:
	editNode.childEvent(id)
	pass # Replace with function body.


func _on_move_pressed() -> void:
	editNode.childEvent(id)
	pass # Replace with function body.


func updata(id,newData):
	editNode.updata(id,newData)


func _on_int_val_value_changed(value: float) -> void:
	updata(id,value)
	pass # Replace with function body.
"

