[gd_scene load_steps=2 format=3 uid="uid://rchhuybax5tq"]

[sub_resource type="GDScript" id="GDScript_dk8xp"]
script/source = "extends ConfirmationDialog

var mainNode
var oldData:Array
var editData
var attributesList=[]
@onready var hadListView:VBoxContainer=$HBoxContainer/PanelContainer/VBoxContainer/ScrollContainer/VBoxContainer
@onready var allListView:VBoxContainer=$HBoxContainer/PanelContainer2/VBoxContainer/ScrollContainer/VBoxContainer
func changeUi():
	pass
func change():
	pass
enum kind {HAD,ALL}
class AttributeManager:
	var nowKind
	var mainNode
	var attributeList:Array
	var hadListView:VBoxContainer
	var hadManager
	func _init(newKind:kind,hadListView:VBoxContainer,mainNode,attributeList,hadManager) -> void:
		self.nowKind=newKind
		self.hadListView=hadListView
		self.mainNode=mainNode
		self.attributeList=attributeList
		self.hadManager=hadManager
	func childEvent(id):
		if nowKind==kind.HAD:
			for i in hadListView.get_children():
				if i.id==id:
					i.queue_free()
					attributeList.erase(id)
		elif nowKind==kind.ALL:
			for i in hadListView.get_children():
				if i.id==id:
					return
			attributeList.append(id)
			var item=load(\"res://easyBag/scene/attributeItemView.tscn\").instantiate()
			item.id=mainNode.attributesData[id][\"name\"]
			item.moveView=true
			item.showVal=false
			item.editNode=hadManager
			item.mainNode=mainNode
			item.change()
			hadListView.add_child(item)

var hadManager
var allManager

func _ready() -> void:
	attributesList=oldData.duplicate(true)
	hadManager=AttributeManager.new(kind.HAD,hadListView,mainNode,attributesList,hadManager)
	allManager=AttributeManager.new(kind.ALL,hadListView,mainNode,attributesList,hadManager)
	for i in mainNode.attributesData:
		var item=load(\"res://easyBag/scene/attributeItemView.tscn\").instantiate()
		item.id=mainNode.attributesData[i][\"name\"]
		item.moveView=true
		item.showVal=false
		item.editNode=allManager
		item.mainNode=mainNode
		item.change()
		allListView.add_child(item)
	for i in attributesList:
		var item=load(\"res://easyBag/scene/attributeItemView.tscn\").instantiate()
		item.id=mainNode.attributesData[i][\"name\"]
		item.moveView=true
		item.showVal=false
		item.editNode=hadManager
		item.mainNode=mainNode
		item.change()
		hadListView.add_child(item)


func _on_canceled() -> void:
	queue_free()
	pass # Replace with function body.


func _on_confirmed() -> void:
	print(attributesList.duplicate(true))
	mainNode.itemData[editData][\"attributes\"]=attributesList.duplicate(true)
	for i in mainNode.itemData[editData][\"attributes\"]:
		if not mainNode.itemData[editData][\"attributesVal\"].has(i):
			mainNode.itemData[editData][\"attributesVal\"][i]={\"extendVal\":true,\"val\":\"\"}
	mainNode.change()
	print(\"finish yes winCd\")
	queue_free()
	pass # Replace with function body.
"

