[sub_resource type="GDScript" id="GDScript_eqsdp"]
script/source = "extends FlowContainer

func changeUi():
	if get_parent().mainNode.editItem:
		$editIcon.visible=true
		$editName.visible=true
	else:
		$editIcon.visible=false
		$editName.visible=false
"

[sub_resource type="GDScript" id="GDScript_n14dn"]
script/source = "extends FoldableContainer

func changeUi():
	if get_parent().mainNode.editItem:
		$FlowContainer/editDescription.visible=true
	else:
		$FlowContainer/editDescription.visible=false
"

